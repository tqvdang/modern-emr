# Environment
ASPNETCORE_ENVIRONMENT=Development

# Database Configuration
ConnectionStrings__DefaultConnection=Server=localhost;Database=emr_auth_dev;User=postgres;Password=postgres;Port=5432;

# Redis Configuration  
ConnectionStrings__Redis=localhost:6379

# JWT Configuration (Development - Use strong keys in production!)
JwtSettings__SecretKey=dev-super-secret-jwt-key-for-development-minimum-32-characters
JwtSettings__Issuer=EMR.AuthService.Dev
JwtSettings__Audience=EMR.Applications.Dev
JwtSettings__AccessTokenExpirationMinutes=60
JwtSettings__RefreshTokenExpirationDays=7

# Development Settings (DISABLE IN PRODUCTION!)
Development__EnableTestUsers=true
Development__BypassEmailVerification=true
Development__EnableSwaggerInProduction=false
Development__SeedTestData=true
Development__AllowInsecureHttp=true

# Email Configuration (Development)
Email__SmtpServer=localhost
Email__SmtpPort=1025
Email__Username=dev@test.com
Email__Password=testpassword
Email__FromEmail=noreply@emr-dev.com
Email__FromName=EMR Development

# Social Authentication (Development Keys - Replace with real ones)
Authentication__Google__ClientId=your-dev-google-client-id
Authentication__Google__ClientSecret=your-dev-google-client-secret

Authentication__Microsoft__ClientId=your-dev-microsoft-client-id
Authentication__Microsoft__ClientSecret=your-dev-microsoft-client-secret

Authentication__Facebook__AppId=your-dev-facebook-app-id
Authentication__Facebook__AppSecret=your-dev-facebook-app-secret

Authentication__LinkedIn__ClientId=your-dev-linkedin-client-id
Authentication__LinkedIn__ClientSecret=your-dev-linkedin-client-secret

# Logging
Serilog__MinimumLevel__Default=Information
Serilog__MinimumLevel__Override__Microsoft=Warning
Serilog__MinimumLevel__Override__System=Warning
Serilog__WriteTo__0__Name=Console
Serilog__WriteTo__1__Name=File
Serilog__WriteTo__1__Args__path=logs/auth-service-.log
Serilog__WriteTo__1__Args__rollingInterval=Day

# Security (Relaxed for development)
Security__RequireHttps=false
Security__EnableCors=true
Security__AllowAnyOrigin=true
Security__PasswordRequirements__RequireDigit=false
Security__PasswordRequirements__RequireUppercase=false
Security__PasswordRequirements__RequireNonAlphanumeric=false
Security__PasswordRequirements__RequiredLength=6

# Rate Limiting (Relaxed for development)
RateLimit__EnableRateLimit=false
RateLimit__LoginAttempts=10
RateLimit__WindowMinutes=15